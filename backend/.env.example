# ---- Copy to backend/.env for local development ----

FIREBASE_PROJECT_ID=philadelphia-toolkit-fd760

# Google AI Studio key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-ai-studio-key
GEMINI_MODEL=gemini-3.6-flash

# Frontend origins allowed by CORS (Vite dev + preview)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Auto-promote these emails to admin on first sign-in
BOOTSTRAP_ADMIN_EMAILS=mjonathanvineeth@gmail.com

# ---- Local emulator wiring (only when running `firebase emulators:start`) ----
FIRESTORE_EMULATOR_HOST=localhost:8081
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Attachments feature — only set these if you enable Firebase Storage (Blaze plan).
# Leaving STORAGE_BUCKET blank cleanly disables attachments everywhere.
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
# STORAGE_BUCKET=philadelphia-toolkit-fd760.firebasestorage.app

# ---- Production ----
# Cloud Run: nothing here — grant the runtime service account roles/datastore.user
#            and roles/firebaseauth.admin, and ADC is used automatically.
# Other serverless hosts: paste the whole service-account JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}
