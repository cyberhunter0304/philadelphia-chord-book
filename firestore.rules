rules_version = '2';

// All writes go through the FastAPI backend (Firebase Admin SDK), which bypasses
// these rules. Clients get real-time READ access only; direct client writes are
// denied so validation + role checks live in one place.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Public catalog — anyone can browse and present.
    match /songs/{songId} {
      allow read: if true;
      allow write: if false;
    }
    match /folders/{folderId} {
      allow read: if true;
      allow write: if false;
    }

    // Setlists — owner or admin, plus anything explicitly shared.
    match /setlists/{setlistId} {
      allow read: if resource.data.shared == true
                  || (isSignedIn() && resource.data.owner_uid == request.auth.uid)
                  || isAdmin();
      allow write: if false;
    }

    // User profiles — read your own (or admin); never client-written.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // AI usage counters — backend only.
    match /usage/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }
  }
}
